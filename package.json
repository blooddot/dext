{
  "name": "dext",
  "displayName": "Dext",
  "description": "A typed AI method environment for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "blooddot",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "mcp",
    "codex",
    "claude",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blooddot/dext.git"
  },
  "bugs": {
    "url": "https://github.com/blooddot/dext/issues"
  },
  "homepage": "https://github.com/blooddot/dext#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onView:dext.sidebar",
    "onCommand:dext.openHistory",
    "onCommand:dext.copySelectionWithContext",
    "onCommand:dext.setMcpAccessToken",
    "onCommand:dext.clearMcpAccessToken",
    "onCommand:dext.verifyMcpServer",
    "onLanguage:dext-api"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dext.focus",
        "title": "Dext: Focus Input",
        "icon": "$(terminal)"
      },
      {
        "command": "dext.reloadMethods",
        "title": "Dext: Reload APIs",
        "icon": "$(refresh)"
      },
      {
        "command": "dext.openHistory",
        "title": "Dext: Open History",
        "icon": "$(history)"
      },
      {
        "command": "dext.newConversation",
        "title": "Dext: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "dext.history.continueConversation",
        "title": "Continue in Dext"
      },
      {
        "command": "dext.history.forkConversation",
        "title": "Fork Conversation"
      },
      {
        "command": "dext.history.forkFromTurn",
        "title": "Fork From This Turn"
      },
      {
        "command": "dext.history.editTurnInput",
        "title": "Edit This Input in Dext"
      },
      {
        "command": "dext.history.copyConversation",
        "title": "Copy Conversation as Markdown"
      },
      {
        "command": "dext.history.deleteConversation",
        "title": "Delete Conversation"
      },
      {
        "command": "dext.history.renameConversation",
        "title": "Rename Conversation"
      },
      {
        "command": "dext.tab.renameConversation",
        "title": "Rename"
      },
      {
        "command": "dext.history.addFavorite",
        "title": "Add to Favorites"
      },
      {
        "command": "dext.history.removeFavorite",
        "title": "Remove from Favorites"
      },
      {
        "command": "dext.history.showNewestFirst",
        "title": "Dext History: Show Newest First",
        "icon": "$(arrow-down)"
      },
      {
        "command": "dext.history.showOldestFirst",
        "title": "Dext History: Show Oldest First",
        "icon": "$(arrow-up)"
      },
      {
        "command": "dext.history.showFavoritesOnly",
        "title": "Dext History: Show Favorites Only",
        "icon": "$(star-empty)"
      },
      {
        "command": "dext.history.showAllConversations",
        "title": "Dext History: Show All Conversations",
        "icon": "$(star-full)"
      },
      {
        "command": "dext.tab.pinConversation",
        "title": "Pin"
      },
      {
        "command": "dext.tab.unpinConversation",
        "title": "Unpin"
      },
      {
        "command": "dext.tab.closeConversation",
        "title": "Close"
      },
      {
        "command": "dext.viewApis",
        "title": "Dext: View APIs",
        "icon": "$(symbol-method)"
      },
      {
        "command": "dext.openWorkspaceTrust",
        "title": "Dext: Manage Workspace Trust",
        "icon": "$(shield)"
      },
      {
        "command": "dext.workspaceTrustedStatus",
        "title": "Dext: Workspace Trusted",
        "icon": {
          "light": "media/workspace-trusted.svg",
          "dark": "media/workspace-trusted.svg"
        }
      },
      {
        "command": "dext.workspaceUntrustedStatus",
        "title": "Dext: Workspace Untrusted",
        "icon": {
          "light": "media/workspace-untrusted.svg",
          "dark": "media/workspace-untrusted.svg"
        }
      },
      {
        "command": "dext.triggerSuggest",
        "title": "Dext: Trigger Suggestions",
        "icon": "$(symbol-field)"
      },
      {
        "command": "dext.triggerParameterHints",
        "title": "Dext: Trigger Parameter Hints",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "dext.addSelectionToChat",
        "title": "Dext: Add Selection to Dext Input",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dext.copySelectionWithContext",
        "title": "Dext: Copy Selection with Context",
        "icon": "$(copy)"
      },
      {
        "command": "dext.addFileToChat",
        "title": "Dext: Add File to Dext Input",
        "icon": "$(files)"
      },
      {
        "command": "dext.configureAgent",
        "title": "Dext: Configure Agent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dext.setMcpAccessToken",
        "title": "Dext: Set MCP Access Token",
        "icon": "$(key)"
      },
      {
        "command": "dext.clearMcpAccessToken",
        "title": "Dext: Clear MCP Access Token",
        "icon": "$(key)"
      },
      {
        "command": "dext.verifyMcpServer",
        "title": "Dext: Verify MCP Server",
        "icon": "$(plug)"
      }
    ],
    "keybindings": [
      {
        "command": "dext.triggerSuggest",
        "key": "alt+/"
      },
      {
        "command": "dext.copySelectionWithContext",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && editorHasSelection && config.dext.captureSelectionOnCopy"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dext.workspaceTrustedStatus",
          "when": "false"
        },
        {
          "command": "dext.workspaceUntrustedStatus",
          "when": "false"
        },
        {
          "command": "dext.history.continueConversation",
          "when": "false"
        },
        {
          "command": "dext.history.forkConversation",
          "when": "false"
        },
        {
          "command": "dext.history.forkFromTurn",
          "when": "false"
        },
        {
          "command": "dext.history.editTurnInput",
          "when": "false"
        },
        {
          "command": "dext.history.copyConversation",
          "when": "false"
        },
        {
          "command": "dext.history.deleteConversation",
          "when": "false"
        },
        {
          "command": "dext.history.renameConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.renameConversation",
          "when": "false"
        },
        {
          "command": "dext.history.addFavorite",
          "when": "false"
        },
        {
          "command": "dext.history.removeFavorite",
          "when": "false"
        },
        {
          "command": "dext.history.showNewestFirst",
          "when": "false"
        },
        {
          "command": "dext.history.showOldestFirst",
          "when": "false"
        },
        {
          "command": "dext.history.showFavoritesOnly",
          "when": "false"
        },
        {
          "command": "dext.history.showAllConversations",
          "when": "false"
        },
        {
          "command": "dext.tab.pinConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.unpinConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.closeConversation",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "dext.history.showFavoritesOnly",
          "when": "activeWebviewPanelId == 'dext.history' && !dext.historyFavoritesOnly",
          "group": "navigation@1"
        },
        {
          "command": "dext.history.showAllConversations",
          "when": "activeWebviewPanelId == 'dext.history' && dext.historyFavoritesOnly",
          "group": "navigation@1"
        },
        {
          "command": "dext.history.showOldestFirst",
          "when": "activeWebviewPanelId == 'dext.history' && dext.historyNewestFirst",
          "group": "navigation@2"
        },
        {
          "command": "dext.history.showNewestFirst",
          "when": "activeWebviewPanelId == 'dext.history' && !dext.historyNewestFirst",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dext.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "dext@1"
        },
        {
          "command": "dext.copySelectionWithContext",
          "when": "editorHasSelection",
          "group": "dext@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dext.addFileToChat",
          "when": "resourceScheme != untitled",
          "group": "dext@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "dext.addFileToChat",
          "when": "resourceScheme != untitled",
          "group": "dext@1"
        }
      ],
      "view/title": [
        {
          "command": "dext.workspaceTrustedStatus",
          "when": "view == dext.sidebar && dext.workspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "dext.workspaceUntrustedStatus",
          "when": "view == dext.sidebar && !dext.workspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "dext.newConversation",
          "when": "view == dext.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "dext.openHistory",
          "when": "view == dext.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "dext.viewApis",
          "when": "view == dext.sidebar",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "dext.history.forkFromTurn",
          "when": "webviewId == 'dext.history' && webviewSection == 'turn'",
          "group": "1_turn@1"
        },
        {
          "command": "dext.history.editTurnInput",
          "when": "webviewId == 'dext.history' && webviewSection == 'turn'",
          "group": "1_turn@2"
        },
        {
          "command": "dext.history.continueConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@1"
        },
        {
          "command": "dext.history.forkConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@2"
        },
        {
          "command": "dext.history.copyConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "3_copy@1"
        },
        {
          "command": "dext.history.renameConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@0"
        },
        {
          "command": "dext.history.addFavorite",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn') && !dextFavorite",
          "group": "2_conversation@3"
        },
        {
          "command": "dext.history.removeFavorite",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn') && dextFavorite",
          "group": "2_conversation@3"
        },
        {
          "command": "dext.history.deleteConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "4_delete@1"
        },
        {
          "command": "dext.tab.renameConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab'",
          "group": "0_rename@1"
        },
        {
          "command": "dext.tab.pinConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab' && !dextTabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "dext.tab.unpinConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab' && dextTabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "dext.tab.closeConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab'",
          "group": "2_close@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dext",
          "title": "Dext",
          "icon": "media/dext.svg"
        }
      ]
    },
    "views": {
      "dext": [
        {
          "id": "dext.sidebar",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "dext-api",
        "extensions": [
          ".dx"
        ],
        "aliases": [
          "Dext API"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dext-api",
        "scopeName": "source.dext-api",
        "path": "./syntaxes/dext-api.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Dext",
      "properties": {
        "dext.captureSelectionOnCopy": {
          "type": "boolean",
          "default": true,
          "description": "Capture editor selections as Dext context when copying with Ctrl+C or Cmd+C. The clipboard still receives the exact selected text. Disable this to use VS Code's native copy behavior."
        },
        "dext.skillDirs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Additional skill directories. Relative paths resolve from the current workspace; earlier directories take priority for duplicate skill names."
        },
          "dext.mcpTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["server", "tool"],
            "properties": {
              "server": { "type": "string" },
              "tool": { "type": "string" },
              "description": { "type": "string" }
            }
          },
            "description": "MCP tools Dext may call. Their public name is the exact configured server.tool value; each tool must reference an entry in dext.mcpServers."
          },
          "dext.mcpServers": {
            "type": "array",
            "default": [],
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["name", "transport", "command"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "transport": { "enum": ["stdio"] },
                    "command": { "type": "string" },
                    "args": { "type": "array", "items": { "type": "string" } },
                    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                },
                {
                  "type": "object",
                  "required": ["name", "transport", "url"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "transport": { "enum": ["http"] },
                    "url": { "type": "string", "format": "uri" },
                    "auth": {
                      "type": "object",
                      "required": ["type"],
                      "additionalProperties": false,
                      "properties": { "type": { "enum": ["bearer"] } }
                    },
                    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                }
              ]
            },
            "description": "MCP servers. Stdio commands run locally. HTTP endpoints must use HTTPS or loopback HTTP; use Dext commands to store bearer tokens in VS Code SecretStorage, never this setting."
          }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test:build-assets": "node scripts/assertWebviewAssets.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:host": "npm run build && node scripts/runExtensionTest.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:build-assets",
    "package": "vsce package",
    "vscode:prepublish": "npm run check"
  },
  "dependencies": {
    "@ax-llm/ax": "23.0.11",
    "chrome-remote-interface": "^0.34.0",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^14.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@eslint/js": "9.39.1",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/python": "^1.1.18",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "24.10.1",
    "@types/vscode": "1.105.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vitest": "4.1.10"
  }
}
