{
  "name": "dext",
  "displayName": "Dext",
  "description": "A typed AI method environment for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "blooddot",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "mcp",
    "codex",
    "claude",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/blooddot/dext.git"
  },
  "bugs": {
    "url": "https://github.com/blooddot/dext/issues"
  },
  "homepage": "https://github.com/blooddot/dext#readme",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:dext.sidebar",
    "onCommand:dext.openHistory",
    "onCommand:dext.copySelectionWithContext",
    "onCommand:dext.setMcpAccessToken",
    "onCommand:dext.clearMcpAccessToken",
    "onCommand:dext.setCompletionApiKey",
    "onCommand:dext.clearCompletionApiKey",
    "onCommand:dext.toggleCompletion",
    "onCommand:dext.completionMenu",
    "onCommand:dext.configureCompletionModel",
    "onCommand:dext.testCompletionModel",
    "onCommand:dext.diagnoseCompletion",
    "onCommand:dext.verifyMcpServer",
    "onLanguage:dext-api"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dext.focus",
        "title": "Dext: Focus Input",
        "icon": "$(terminal)"
      },
      {
        "command": "dext.reloadMethods",
        "title": "Dext: Reload APIs",
        "icon": "$(refresh)"
      },
      {
        "command": "dext.openHistory",
        "title": "Dext: Open History",
        "icon": "$(history)"
      },
      {
        "command": "dext.newConversation",
        "title": "Dext: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "dext.stopExecution",
        "title": "Dext: Stop Execution",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dext.history.continueConversation",
        "title": "Continue in Dext"
      },
      {
        "command": "dext.history.forkConversation",
        "title": "Fork Conversation"
      },
      {
        "command": "dext.history.forkFromTurn",
        "title": "Fork From This Turn"
      },
      {
        "command": "dext.history.editTurnInput",
        "title": "Edit This Input in Dext"
      },
      {
        "command": "dext.history.recordWorkflow",
        "title": "Record Conversation as Dext Workflow"
      },
      {
        "command": "dext.history.copyConversation",
        "title": "Copy Conversation as Markdown"
      },
      {
        "command": "dext.history.deleteConversation",
        "title": "Delete Conversation"
      },
      {
        "command": "dext.history.renameConversation",
        "title": "Rename Conversation"
      },
      {
        "command": "dext.tab.renameConversation",
        "title": "Rename"
      },
      {
        "command": "dext.history.addFavorite",
        "title": "Add to Favorites"
      },
      {
        "command": "dext.history.removeFavorite",
        "title": "Remove from Favorites"
      },
      {
        "command": "dext.history.showNewestFirst",
        "title": "Dext History: Show Newest First",
        "icon": "$(arrow-down)"
      },
      {
        "command": "dext.history.showOldestFirst",
        "title": "Dext History: Show Oldest First",
        "icon": "$(arrow-up)"
      },
      {
        "command": "dext.history.showFavoritesOnly",
        "title": "Dext History: Show Favorites Only",
        "icon": "$(star-empty)"
      },
      {
        "command": "dext.history.showAllConversations",
        "title": "Dext History: Show All Conversations",
        "icon": "$(star-full)"
      },
      {
        "command": "dext.tab.pinConversation",
        "title": "Pin"
      },
      {
        "command": "dext.tab.unpinConversation",
        "title": "Unpin"
      },
      {
        "command": "dext.tab.closeConversation",
        "title": "Close"
      },
      {
        "command": "dext.viewApis",
        "title": "Dext: View APIs",
        "icon": "$(symbol-method)"
      },
      {
        "command": "dext.openWorkspaceTrust",
        "title": "Dext: Manage Workspace Trust",
        "icon": "$(shield)"
      },
      {
        "command": "dext.workspaceTrustedStatus",
        "title": "Dext: Workspace Trusted",
        "icon": {
          "light": "media/workspace-trusted.svg",
          "dark": "media/workspace-trusted.svg"
        }
      },
      {
        "command": "dext.workspaceUntrustedStatus",
        "title": "Dext: Workspace Untrusted",
        "icon": {
          "light": "media/workspace-untrusted.svg",
          "dark": "media/workspace-untrusted.svg"
        }
      },
      {
        "command": "dext.triggerSuggest",
        "title": "Dext: Trigger Suggestions",
        "icon": "$(symbol-field)"
      },
      {
        "command": "dext.triggerParameterHints",
        "title": "Dext: Trigger Parameter Hints",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "dext.addSelectionToChat",
        "title": "Dext: Add Selection to Dext Input",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dext.copySelectionWithContext",
        "title": "Dext: Copy Selection with Context",
        "icon": "$(copy)"
      },
      {
        "command": "dext.addFileToChat",
        "title": "Dext: Add File to Dext Input",
        "icon": "$(files)"
      },
      {
        "command": "dext.configureAgent",
        "title": "Dext: Configure Agent",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dext.setMcpAccessToken",
        "title": "Dext: Set MCP Access Token",
        "icon": "$(key)"
      },
      {
        "command": "dext.configureCompletionModel",
        "title": "Dext: Configure Completion Model",
        "icon": "$(gear)"
      },
      {
        "command": "dext.completionMenu",
        "title": "Dext: Inline Completion Options"
      },
      {
        "command": "dext.testCompletionModel",
        "title": "Dext: Test Completion Model"
      },
      {
        "command": "dext.diagnoseCompletion",
        "title": "Dext: Diagnose Inline Completion"
      },
      {
        "command": "dext.setCompletionApiKey",
        "title": "Dext: Set Completion API Key",
        "icon": "$(key)"
      },
      {
        "command": "dext.clearCompletionApiKey",
        "title": "Dext: Clear Completion API Key",
        "icon": "$(key)"
      },
      {
        "command": "dext.toggleCompletion",
        "title": "Dext: Toggle Inline Completion"
      },
      {
        "command": "dext.clearMcpAccessToken",
        "title": "Dext: Clear MCP Access Token",
        "icon": "$(key)"
      },
      {
        "command": "dext.verifyMcpServer",
        "title": "Dext: Verify MCP Server",
        "icon": "$(plug)"
      }
    ],
    "keybindings": [
      {
        "command": "dext.triggerSuggest",
        "key": "alt+/"
      },
      {
        "command": "dext.focus",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      },
      {
        "command": "dext.newConversation",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "dext.stopExecution",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "dext.running"
      },
      {
        "command": "dext.copySelectionWithContext",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus && editorHasSelection && config.dext.captureSelectionOnCopy"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "dext.setCompletionApiKey",
          "when": "false"
        },
        {
          "command": "dext.clearCompletionApiKey",
          "when": "false"
        },
        {
          "command": "dext.testCompletionModel",
          "when": "false"
        },
        {
          "command": "dext.toggleCompletion",
          "when": "false"
        },
        {
          "command": "dext.triggerSuggest",
          "when": "false"
        },
        {
          "command": "dext.triggerParameterHints",
          "when": "false"
        },
        {
          "command": "dext.sidebar.focus",
          "when": "false"
        },
        {
          "command": "dext.workspaceTrustedStatus",
          "when": "false"
        },
        {
          "command": "dext.workspaceUntrustedStatus",
          "when": "false"
        },
        {
          "command": "dext.history.continueConversation",
          "when": "false"
        },
        {
          "command": "dext.history.forkConversation",
          "when": "false"
        },
        {
          "command": "dext.history.forkFromTurn",
          "when": "false"
        },
        {
          "command": "dext.history.editTurnInput",
          "when": "false"
        },
        {
          "command": "dext.history.recordWorkflow",
          "when": "false"
        },
        {
          "command": "dext.history.copyConversation",
          "when": "false"
        },
        {
          "command": "dext.history.deleteConversation",
          "when": "false"
        },
        {
          "command": "dext.history.renameConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.renameConversation",
          "when": "false"
        },
        {
          "command": "dext.history.addFavorite",
          "when": "false"
        },
        {
          "command": "dext.history.removeFavorite",
          "when": "false"
        },
        {
          "command": "dext.history.showNewestFirst",
          "when": "false"
        },
        {
          "command": "dext.history.showOldestFirst",
          "when": "false"
        },
        {
          "command": "dext.history.showFavoritesOnly",
          "when": "false"
        },
        {
          "command": "dext.history.showAllConversations",
          "when": "false"
        },
        {
          "command": "dext.tab.pinConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.unpinConversation",
          "when": "false"
        },
        {
          "command": "dext.tab.closeConversation",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "dext.history.showFavoritesOnly",
          "when": "activeWebviewPanelId == 'dext.history' && !dext.historyFavoritesOnly",
          "group": "navigation@1"
        },
        {
          "command": "dext.history.showAllConversations",
          "when": "activeWebviewPanelId == 'dext.history' && dext.historyFavoritesOnly",
          "group": "navigation@1"
        },
        {
          "command": "dext.history.showOldestFirst",
          "when": "activeWebviewPanelId == 'dext.history' && dext.historyNewestFirst",
          "group": "navigation@2"
        },
        {
          "command": "dext.history.showNewestFirst",
          "when": "activeWebviewPanelId == 'dext.history' && !dext.historyNewestFirst",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "dext.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "dext@1"
        },
        {
          "command": "dext.copySelectionWithContext",
          "when": "editorHasSelection",
          "group": "dext@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dext.addFileToChat",
          "when": "resourceScheme != untitled",
          "group": "dext@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "dext.addFileToChat",
          "when": "resourceScheme != untitled",
          "group": "dext@1"
        }
      ],
      "view/title": [
        {
          "command": "dext.workspaceTrustedStatus",
          "when": "view == dext.sidebar && dext.workspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "dext.workspaceUntrustedStatus",
          "when": "view == dext.sidebar && !dext.workspaceTrusted",
          "group": "navigation@0"
        },
        {
          "command": "dext.newConversation",
          "when": "view == dext.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "dext.openHistory",
          "when": "view == dext.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "dext.viewApis",
          "when": "view == dext.sidebar",
          "group": "navigation@3"
        }
      ],
      "webview/context": [
        {
          "command": "dext.history.forkFromTurn",
          "when": "webviewId == 'dext.history' && webviewSection == 'turn'",
          "group": "1_turn@1"
        },
        {
          "command": "dext.history.editTurnInput",
          "when": "webviewId == 'dext.history' && webviewSection == 'turn'",
          "group": "1_turn@2"
        },
        {
          "command": "dext.history.continueConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@1"
        },
        {
          "command": "dext.history.forkConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@2"
        },
        {
          "command": "dext.history.recordWorkflow",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn') && dext.workspaceTrusted",
          "group": "2_conversation@3"
        },
        {
          "command": "dext.history.copyConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "3_copy@1"
        },
        {
          "command": "dext.history.renameConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "2_conversation@0"
        },
        {
          "command": "dext.history.addFavorite",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn') && !dextFavorite",
          "group": "2_conversation@3"
        },
        {
          "command": "dext.history.removeFavorite",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn') && dextFavorite",
          "group": "2_conversation@3"
        },
        {
          "command": "dext.history.deleteConversation",
          "when": "webviewId == 'dext.history' && (webviewSection == 'session' || webviewSection == 'turn')",
          "group": "4_delete@1"
        },
        {
          "command": "dext.tab.renameConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab'",
          "group": "0_rename@1"
        },
        {
          "command": "dext.tab.pinConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab' && !dextTabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "dext.tab.unpinConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab' && dextTabPinned",
          "group": "1_pin@1"
        },
        {
          "command": "dext.tab.closeConversation",
          "when": "webviewId == 'dext.sidebar' && webviewSection == 'conversationTab'",
          "group": "2_close@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dext",
          "title": "Dext",
          "icon": "media/dext.svg"
        }
      ]
    },
    "views": {
      "dext": [
        {
          "id": "dext.sidebar",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "languages": [
      {
        "id": "dext-api",
        "extensions": [
          ".dx"
        ],
        "aliases": [
          "Dext API"
        ]
      }
    ],
    "grammars": [
      {
        "language": "dext-api",
        "scopeName": "source.dext-api",
        "path": "./syntaxes/dext-api.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Dext",
      "properties": {
        "dext.captureSelectionOnCopy": {
          "type": "boolean",
          "default": true,
          "description": "Capture editor selections as Dext context when copying with Ctrl+C or Cmd+C. The clipboard still receives the exact selected text. Disable this to use VS Code's native copy behavior."
        },
        "dext.skillDirs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Additional skill directories. Relative paths resolve from the current workspace; earlier directories take priority for duplicate skill names."
        },
        "dext.apiDirs": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Additional directories searched for .dx API files. Relative paths resolve from the current workspace. The workspace's own .dext/api is always searched first, so a configured directory cannot shadow a project API."
        },
        "dext.plan.directory": {
          "type": "string",
          "default": ".dext/plans",
          "description": "Workspace-relative directory where Plan mode saves its documents. Must stay inside the workspace."
        },
        "dext.submitOnEnter": {
          "type": "boolean",
          "default": true,
          "description": "Send the message with Enter in Agent, Ask, and Plan modes, using Shift+Enter for a newline. Turn this off to require Ctrl+Enter to send. Code mode always runs with Ctrl+Enter."
        },
        "dext.diff.defaultView": {
          "type": "string",
          "default": "inline",
          "enum": ["inline", "split"],
          "enumDescriptions": [
            "Show removed and added lines in one column.",
            "Show before and after side by side."
          ],
          "description": "Layout a file change opens in. Each change can still be switched individually after it is shown."
        },
        "dext.history.maxTurns": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "description": "Turns kept across all conversations. The oldest turns are dropped first, which also removes them from the conversation tab strip."
        },
        "dext.history.maxOutputLength": {
          "type": "integer",
          "default": 200000,
          "minimum": 1000,
          "description": "Characters kept per stored input, process event, and serialized output before history truncates it."
        },
        "dext.agentPermission": {
          "type": "string",
          "default": "workspace-write",
          "enum": ["read-only", "workspace-write", "full-access"],
          "enumDescriptions": [
            "Agent turns propose a patch and change nothing until the change is accepted in Dext Output.",
            "Agent turns edit the trusted workspace directly, the way the selected CLI would on its own.",
            "Agent turns run without the provider sandbox and may touch anything the CLI can reach."
          ],
          "description": "Starting permission tier for Agent mode. The composer's Permission control overrides this for the current conversation. Ask and Plan are always read-only."
        },
        "dext.agentCliArgs": {
          "type": "object",
          "default": {},
          "properties": {
            "codex": { "type": "array", "items": { "type": "string" }, "description": "Extra arguments appended to every Codex invocation." },
            "claude": { "type": "array", "items": { "type": "string" }, "description": "Extra arguments appended to every Claude Code invocation." },
            "aioa": { "type": "array", "items": { "type": "string" }, "description": "Reserved; AIOA runs over CDP and takes no CLI arguments." }
          },
          "additionalProperties": false,
          "markdownDescription": "Extra CLI arguments passed through to each agent provider, appended after the arguments Dext builds. Ignored outside a trusted workspace. Dext's own flags win, so these cannot loosen the permission tier."
        },
        "dext.agent.timeoutMs": {
          "type": "integer",
          "default": 600000,
          "minimum": 1000,
          "description": "How long a single CLI agent turn may run before Dext aborts it. Raise this when long refactors are being cut off mid-run."
        },
        "dext.aioa.timeoutMs": {
          "type": "integer",
          "default": 3600000,
          "minimum": 1000,
          "description": "How long an AIOA turn may run in total before Dext gives up on it."
        },
        "dext.aioa.idleTimeoutMs": {
          "type": "integer",
          "default": 90000,
          "minimum": 1000,
          "description": "How long AIOA may go without producing new output before Dext treats the turn as stalled. Raise this when AIOA thinks for a long time between updates."
        },
        "dext.terminal.defaultTimeoutMs": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "Timeout applied to terminal() calls that do not pass timeout_ms. Values are capped at 600000 milliseconds, which is also the hard ceiling for an explicit timeout_ms."
        },
        "dext.completion": {
          "type": "object",
          "default": {},
          "markdownDeprecationMessage": "Replaced by the individual `dext.completion.*` settings, which the Settings UI can render as a dropdown and text boxes rather than an untyped table. Dext moves any values across on startup and then removes this entry, so nothing needs to be done by hand.",
          "description": "Superseded by the individual dext.completion.* settings."
        },
        "dext.completion.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Offer inline completions while typing. Stays off until `#dext.completion.endpoint#` and `#dext.completion.model#` are both set.\n\n**Fastest way in:** [Configure completion model](command:dext.configureCompletionModel) asks for the API format, the request URL, the model ID and the API key in one pass, then offers to test the connection. It is also on the Dext status bar item.\n\n**API key:** there is deliberately no API key box on this page. A key in `settings.json` ends up in source control or a synced profile sooner or later, so it is kept in VS Code's encrypted secret storage: [Set API key](command:dext.setCompletionApiKey) · [Clear API key](command:dext.clearCompletionApiKey)"
        },
        "dext.completion.api": {
          "type": "string",
          "default": "openai",
          "enum": ["openai", "openai-chat", "anthropic", "ollama"],
          "enumDescriptions": [
            "POST <base>/completions. A dedicated fill-in-the-middle model that accepts a prompt and a suffix. Fastest and most exact, but a chat model answered through this format returns a body it cannot read.",
            "POST <base>/chat/completions. What most providers actually expose, DeepSeek and Qwen included. There is no suffix field, so the code around the cursor is sent as a chat prompt.",
            "POST <base>/messages. Claude has no fill-in-the-middle endpoint, so the code around the cursor is sent as a chat prompt instead, which is slower and less exact.",
            "POST <base>/api/generate. A local Ollama server using its own fill-in-the-middle fields."
          ],
          "description": "API format the completion model speaks. This has to match what the endpoint serves: the wrong choice returns a valid response that no completion can be read out of."
        },
        "dext.completion.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of the completion model, with no trailing slash. The API path for the chosen format is appended if it is not already there, so `https://api.openai.com/v1` reaches `/v1/completions`.\n\nUsual values: `https://api.openai.com/v1`, `https://api.anthropic.com/v1`, `http://localhost:11434`."
        },
        "dext.completion.model": {
          "type": "string",
          "default": "",
          "description": "Model ID to complete with. For the openai and ollama formats it must support fill-in-the-middle, since Dext sends both a prefix and a suffix. The anthropic format emulates that with a chat prompt, so pick the fastest Claude model available."
        },
        "dext.completion.maxTokens": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 2048,
          "description": "Longest completion to request. This is the main thing deciding how long a suggestion takes to appear, because generation time scales with it. A completion is a continuation of a line or two, not a whole function, so raise it only if suggestions are being cut short."
        },
        "dext.completion.debounceMs": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "maximum": 5000,
          "description": "Idle time after the last keystroke before a completion is requested. Only the first keystroke of a burst waits: once a request is in flight the following keystrokes wait on that same answer rather than starting another. Keeping under the provider's requests-per-second limit is handled separately, by spacing requests out once the provider says they are arriving too quickly, so this does not need raising for that."
        },
        "dext.completion.prefixChars": {
          "type": "integer",
          "default": 4000,
          "minimum": 1,
          "maximum": 32000,
          "description": "Characters before the cursor sent as context. Measured in characters rather than lines so one long generated line cannot exhaust the budget."
        },
        "dext.completion.suffixChars": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "maximum": 32000,
          "description": "Characters after the cursor sent as context."
        },
        "dext.completion.timeoutMs": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "maximum": 30000,
          "description": "How long a completion request may take before it is abandoned. Hosted gateways routinely need several seconds to emit maxTokens tokens, and a request abandoned at that point has burned them without showing anything. Waiting longer costs little, because the editor cancels the request as soon as the next key is pressed."
        },
        "dext.completion.ignoreGitignore": {
          "type": "boolean",
          "default": true,
          "description": "Do not complete in files excluded by .gitignore. A .dextignore file in the workspace root adds further exclusions and is honored either way."
        },
        "dext.workflow.maxConcurrency": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 16,
          "description": "Branches a list comprehension runs at once in Code mode. Each branch can start its own agent process, so raising this multiplies both throughput and machine load. Everything outside a comprehension stays sequential."
        },
          "dext.mcpTools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["server", "tool"],
            "properties": {
              "server": { "type": "string" },
              "tool": { "type": "string" },
              "description": { "type": "string" }
            }
          },
            "description": "MCP tools Dext may call. Their public name is the exact configured server.tool value; each tool must reference an entry in dext.mcpServers."
          },
          "dext.mcpServers": {
            "type": "array",
            "default": [],
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["name", "transport", "command"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "transport": { "enum": ["stdio"] },
                    "command": { "type": "string" },
                    "args": { "type": "array", "items": { "type": "string" } },
                    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                },
                {
                  "type": "object",
                  "required": ["name", "transport", "url"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string" },
                    "transport": { "enum": ["http"] },
                    "url": { "type": "string", "format": "uri" },
                    "auth": {
                      "type": "object",
                      "required": ["type"],
                      "additionalProperties": false,
                      "properties": { "type": { "enum": ["bearer"] } }
                    },
                    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                }
              ]
            },
            "description": "MCP servers. Stdio commands run locally. HTTP endpoints must use HTTPS or loopback HTTP; use Dext commands to store bearer tokens in VS Code SecretStorage, never this setting."
          }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test:build-assets": "node scripts/assertWebviewAssets.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:host": "npm run build && node scripts/runExtensionTest.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:build-assets",
    "package": "vsce package",
    "vscode:prepublish": "npm run check"
  },
